#!/bin/java bsh.Interpreter

source("TestHarness.bsh");
source("Assert.bsh");

f=(float) 5;
assertEquals(5f, f, 1);
assertEquals(0i, (int) 0.5);

a=0.3;
assertEquals(0i, (int) a);

d=(double) +1;
assertEquals(1.0d, d, 1);

// this is ok of course
String s = null;
assertNull(s);
// but this should be as well
String s2 = (String) null;
assertNull(s2);
assertNull((Object) null);
assertNotNull((int) null);

// cast null to primitive default value
assertEquals(0o, (byte) null);
assertEquals(0s, (short) null);
assertEquals(0i, (int) null);
assertEquals(0l, (long) null);
assertEquals(0.0f, (float) null, 1);
assertEquals(0.0d, (double) null, 1);
assertEquals(false, (boolean) null);
assertEquals('\000', (char) null);

int x = (int) 'a';
assertEquals(97i, x);

// can't cast void to anything
assert( isEvalError("Cannot cast void value to int", "(int) xyz"));
assert( isEvalError("Cannot cast void value to Object", "(Object) xyz"));

// cast primitives to object types get boxed
assertThat((Object) 5o, instanceOf(Byte.class));
assertThat((Object) 5s, instanceOf(Short.class));
assertThat((Object) 5i, instanceOf(Integer.class));
assertThat((Object) 5l, instanceOf(Long.class));
assertThat((Object) 5f, instanceOf(Float.class));
assertThat((Object) 5d, instanceOf(Double.class));
assertThat((Object) '5', instanceOf(Character.class));
assertThat((Object) true, instanceOf(Boolean.class));
// cast boxed types to primitives
assertEquals('a', (char) Character.valueOf('a'));
assertEquals(1o, (byte) Byte.valueOf(1o));
assertEquals(2s, (short) Short.valueOf(2s));
assertEquals(3i, (int) Integer.valueOf(3i));
assertEquals(4l, (long) Long.valueOf(4l));
assertEquals(5.0f, (float) Float.valueOf(5f), 1);
assertEquals(6.0d, (double) Double.valueOf(6d), 1);
assertEquals(true, (boolean) Boolean.TRUE);

// boolean cannot be cast to numbers
assert( isEvalError("bad type in cast false", "(char) false"));
assert( isEvalError("bad type in cast false", "(byte) false"));
assert( isEvalError("bad type in cast false", "(short) false"));
assert( isEvalError("bad type in cast false", "(int) false"));
assert( isEvalError("bad type in cast false", "(long) false"));
assert( isEvalError("bad type in cast false", "(float) false"));
assert( isEvalError("bad type in cast false", "(double) false"));
assert( isEvalError("bad type in cast true", "(char) true"));
assert( isEvalError("bad type in cast true", "(byte) true"));
assert( isEvalError("bad type in cast true", "(short) true"));
assert( isEvalError("bad type in cast true", "(int) true"));
assert( isEvalError("bad type in cast true", "(long) true"));
assert( isEvalError("bad type in cast true", "(float) true"));
assert( isEvalError("bad type in cast true", "(double) true"));

// cast to boolean
// 0, null, or empty string is error
assertEquals(false, (boolean) false);
assertEquals(true, (boolean) true);
assert( isEvalError("cannot cast Integer to boolean", "(boolean) '\000'"));
assert( isEvalError("cannot cast Byte to boolean", "(boolean) 0o"));
assert( isEvalError("cannot cast Short to boolean", "(boolean) 0s"));
assert( isEvalError("cannot cast Integer to boolean", "(boolean) 0i"));
assert( isEvalError("cannot cast Long to boolean", "(boolean) 0l"));
assert( isEvalError("cannot cast Float to boolean", "(boolean) 0.0f"));
assert( isEvalError("cannot cast Double to boolean", "(boolean) 0.0d"));
assert( isEvalError("cannot cast String to boolean", "(boolean) ''"));
assert( isEvalError("cannot cast Object to boolean", "(boolean) new Object()"));
assert( isEvalError("cannot cast Class to boolean", "(boolean) Class.class"));
assertEquals(false, (boolean) null);

// typed variable assignment
byte b;
assertEquals(0o, b);
assertEquals(0o, b = null);
assertEquals(0o, b = '\000');
assert( isEvalError("bad type in cast false", "b = false"));
assert( isEvalError("bad type in cast true", "b = true"));
assertEquals(123o, b = 123);
Byte B;
assertNull(B);
assertNull(B = null);
assertEquals(0o, B = '\000');
assert( isEvalError("bad type in cast false", "B = false"));
assert( isEvalError("bad type in cast true", "B = true"));
assertEquals(123o, B = 123);
short ss;
assertEquals(0s, ss);
assertEquals(0s, ss = null);
assertEquals(0s, ss = '\000');
assert( isEvalError("bad type in cast false", "ss = false"));
assert( isEvalError("bad type in cast true", "ss = true"));
assertEquals(123s, ss = 123);
Short S;
assertNull(S);
assertNull(S = null);
assertEquals(0s, S = '\000');
assert( isEvalError("bad type in cast false", "S = false"));
assert( isEvalError("bad type in cast true", "S = true"));
assertEquals(123s, S = 123);
int i;
assertEquals(0i, i);
assertEquals(0i, i = null);
assertEquals(0i, i = '\000');
assert( isEvalError("bad type in cast false", "i = false"));
assert( isEvalError("bad type in cast true", "i = true"));
assertEquals(123i, i = 123);
Integer I;
assertNull(I);
assertNull(I = null);
assertEquals(0i, I = '\000');
assert( isEvalError("bad type in cast false", "I = false"));
assert( isEvalError("bad type in cast true", "I = true"));
assertEquals(123i, I = 123);
long l;
assertEquals(0l, l);
assertEquals(0l, l = null);
assertEquals(0l, l = '\000');
assert( isEvalError("bad type in cast false", "l = false"));
assert( isEvalError("bad type in cast true", "l = true"));
assertEquals(123l, l = 123);
Long L;
assertNull(L);
assertNull(L = null);
assertEquals(0l, L = '\000');
assert( isEvalError("bad type in cast false", "L = false"));
assert( isEvalError("bad type in cast true", "L = true"));
assertEquals(123l, L = 123);
float f;
assertEquals(0.0f, f, 1);
assertEquals(0.0f, f = null, 1);
assertEquals(0.0f, f = '\000', 1);
assert( isEvalError("bad type in cast false", "f = false"));
assert( isEvalError("bad type in cast true", "f = true"));
assertEquals(123.0f, f = 123, 1);
Float F;
assertNull(F);
assertNull(F = null);
assertEquals(0.0f, F = '\000', 1);
assert( isEvalError("bad type in cast false", "F = false"));
assert( isEvalError("bad type in cast true", "F = true"));
assertEquals(123.0f, F = 123, 1);
double d;
assertEquals(0.0d, d, 1);
assertEquals(0.0d, d = null, 1);
assertEquals(0.0d, d = '\000', 1);
assert( isEvalError("bad type in cast false", "d = false"));
assert( isEvalError("bad type in cast true", "d = true"));
assertEquals(123.0d, d = 123, 1);
Double D;
assertNull(D);
assertNull(D = null);
assertEquals(0.0d, D = '\000', 1);
assert( isEvalError("bad type in cast false", "D = false"));
assert( isEvalError("bad type in cast true", "D = true"));
assertEquals(123.0d, D = 123, 1);
boolean bb;
assertFalse(bb);
assertFalse(bb = null);
assert( isEvalError("cannot cast Integer to boolean", "bb = 0"));
assert( isEvalError("cannot cast String to boolean", "bb = \"\""));
assert( isEvalError("cannot cast Integer to boolean", "bb = '\000'"));
assertFalse(bb = false);
assert( isEvalError("cannot cast Class to boolean", "bb = Boolean.TYPE"));
assert( isEvalError("cannot cast Integer to boolean", "bb = 123"));
assert( isEvalError("cannot cast String to boolean", "bb = \"tick\""));
assert( isEvalError("cannot cast Integer to boolean", "bb = 'a'"));
assertTrue(bb = true);
Boolean BB;
assertNull(BB);
assertNull(BB = null);
assert( isEvalError("cannot cast Integer to boolean", "BB = 0"));
assert( isEvalError("cannot cast String to boolean", "BB = \"\""));
assert( isEvalError("cannot cast Integer to boolean", "BB = '\000'"));
assertFalse(BB = false);
assert( isEvalError("cannot cast Class to boolean", "bb = Boolean.class"));
assert( isEvalError("cannot cast Integer to boolean", "BB = 123"));
assert( isEvalError("cannot cast String to boolean", "BB = \"tick\""));
assert( isEvalError("cannot cast Integer to boolean", "BB = 'a'"));
assertTrue(BB = true);

// can't cast non parseable strings to number
assert( isEvalError('Cannot cast String with value "foo" to int', '(int) "foo"'));
assert( isEvalError('Cannot cast String with value "" to short', '(short) ""'));
assert( isEvalError('Cannot cast String with value "foo" to Integer', '(Integer) "foo";'));

// cast error throws ClassCastException which can be caught
try {
    i=(Integer) "foo";
} catch ( ArithmeticException e0 ) {
    assert(false); // just checking
} catch ( ClassCastException e ) {
    flag();
}
assertEquals(1, flag());

// Casting between numeric reference types works
refObj = (Number) Double.valueOf(1);
assertThat(refObj, instanceOf(Number.class));
assertThat(refObj, instanceOf(Double.class));
assertEquals(refObj, 1.0);

refObj = Double.valueOf(1);
assertThat(refObj, instanceOf(Number.class));
assertThat(refObj, instanceOf(Double.class));
assertEquals(refObj, 1.0);

Number refObj1 = (Number) Double.valueOf(1);
assertThat(refObj1, instanceOf(Number.class));
assertThat(refObj1, instanceOf(Double.class));
assertEquals(refObj1, 1.0);

Number refObj2 = Double.valueOf(1);
assertThat(refObj2, instanceOf(Number.class));
assertThat(refObj2, instanceOf(Double.class));
assertEquals(refObj2, 1.0);

Double refObj3 = (Double) null;
assertEquals(refObj3, null);

assert( isEvalError("bad type in cast true", "(Double) Boolean.TRUE"));

complete();
